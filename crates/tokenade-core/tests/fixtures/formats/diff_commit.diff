diff --git a/crates/tokenade-bench/src/bin/value_ranking.rs b/crates/tokenade-bench/src/bin/value_ranking.rs
new file mode 100644
index 00000000..7748bc9d
--- /dev/null
+++ b/crates/tokenade-bench/src/bin/value_ranking.rs
@@ -0,0 +1,205 @@
+//! Régénère `docs/_value-ranking.md` — la hiérarchie de valeur MESURÉE.
+//!
+//! Elle existe parce qu'une hiérarchie déclarée est une opinion. Celle-ci sort
+//! du registre d'usage réel (`tokenade gain --json`), donc elle dit ce que les
+//! agents empruntent vraiment et ce que ça coûte encore.
+//!
+//! ## Le premier classement était faux, et sa première utilisation l'a montré
+//!
+//! Il triait les « chemins chers et peu efficaces » par octets encore livrés,
+//! sans les rapporter au total. `sysinfo` arrivait donc en tête avec 59 307
+//! usages — et 3 879 492 octets d'entrée, soit **65 octets par appel**. Le gain
+//! restant y valait 1,6 Mo sur 833 Mo économisés : 0,2 %. Trier sur un total
+//! non rapporté sur-pondère les opérations très fréquentes à charge minuscule.
+//!
+//! Corrigé, l'image s'inverse : **76 % de tout ce qui est encore livré vient de
+//! DEUX opérations** (`html-to-markdown` 40,9 %, `auto-compact` 35,0 %), déjà à
+//! −95 % mais si volumineuses que leur résidu domine. Gagner un point sur
+//! `html-to-markdown` rapporte plus que perfectionner `sysinfo` entièrement.
+//!
+//! ## Et il faut écarter mes propres sondes
+//!
+//! `a11y-compact` pesait 11,2 % du livré — 5 appels, tous le même jour. C'est
+//! une sonde d'une itération passée, pas un usage. Le registre porte
+//! `heaviest_day_share` : une opération concentrée sur un seul jour ET peu
+//! employée est du bruit que j'ai fabriqué.
+
+use tokenade_bench::Bench;
+
+/// Une opération concentrée sur UN jour et peu employée est une sonde à moi,
+/// pas un usage réel.
+fn is_self_probe(heaviest_day_share: f64, count: u64) -> bool {
+    heaviest_day_share >= 0.95 && count < 50
+}
+
+/// Ce qu'une opération livre ENCORE — la seule quantité qui dise où il reste à
+/// gagner. `percent` seul sur-pondère le minuscule, `count` seul le fréquent.
+fn still_delivered(before: u64, saved: u64) -> u64 {
+    before.saturating_sub(saved)
+}
+
+fn main() {
+    let bench = match Bench::reading_real_state() {
+        Ok(b) => b,
+        Err(e) => {
+            eprintln!("value_ranking: pas de binaire tokenade à mesurer: {e}");
+            std::process::exit(2);
+        }
+    };
+    let run = match bench.run(&["gain", "--json"]) {
+        Ok(r) => r,
+        Err(e) => {
+            eprintln!("value_ranking: `gain --json` n'a pas pu tourner: {e}");
+            std::process::exit(2);
+        }
+    };
+    if !run.survived() {
+        eprintln!("value_ranking: `gain --json` a été tué par un signal");
+        std::process::exit(2);
+    }
+    let v: serde_json::Value = match serde_json::from_slice(&run.stdout) {
+        Ok(v) => v,
+        Err(e) => {
+            eprintln!("value_ranking: sortie de `gain --json` illisible: {e}");
+            std::process::exit(2);
+        }
+    };
+
+    let delivered_total = v["after"].as_u64().unwrap_or(0).max(1);
+    let ops = v["by_op"].as_array().cloned().unwrap_or_default();
+    let mut rows: Vec<(String, u64, u64, f64, f64, bool)> = ops
+        .iter()
+        .map(|o| {
+            let name = o["op"].as_str().unwrap_or("?").to_string();
+            let count = o["count"].as_u64().unwrap_or(0);
+            let before = o["before"].as_u64().unwrap_or(0);
+            let saved = o["saved"].as_u64().unwrap_or(0);
+            let pct = o["percent"].as_f64().unwrap_or(0.0);
+            let share = o["heaviest_day_share"].as_f64().unwrap_or(0.0);
+            (
+                name,
+                count,
+                still_delivered(before, saved),
+                pct,
+                share,
+                is_self_probe(share, count),
+            )
+        })
+        .collect();
+    rows.sort_by(|a, b| b.2.cmp(&a.2));
+
+    let span = &v["span"];
+    let mut md = String::new();
+    md.push_str("# Classement de valeur — dérivé de l'usage RÉEL\n\n");
+    md.push_str(&format!(
+        "Source : `tokenade gain --json`. **{} opérations**, {} jours, du {} au {}.\n\
+         Régénéré par `cargo run -p tokenade-bench --bin value_ranking`.\n\n",
+        v["operations"].as_u64().unwrap_or(0),
+        span["days"].as_u64().unwrap_or(0),
+        span["first_iso"].as_str().unwrap_or("?").get(..10).unwrap_or("?"),
+        span["last_iso"].as_str().unwrap_or("?").get(..10).unwrap_or("?"),
+    ));
+    md.push_str(
+        "> Une hiérarchie de valeur DÉCLARÉE est une opinion ; celle-ci se mesure.\n\
+         > Rafraîchir si elle a plus de 7 jours, sinon la lire et travailler de haut en bas.\n\n",
+    );
+    md.push_str(&format!(
+        "**Total encore livré aux agents : {} octets.** C'est le gisement.\n\n",
+        thousands(delivered_total)
+    ));
+    md.push_str("## Où il reste à gagner (et où une régression coûte le plus)\n\n");
+    md.push_str("| # | op | usages | encore livré | part du livré | taux |\n");
+    md.push_str("|---|---|---|---|---|---|\n");
+    let mut i = 0;
+    for (name, count, rest, pct, _share, probe) in rows.iter().filter(|r| !r.5) {
+        i += 1;
+        if i > 15 {
+            break;
+        }
+        let _ = probe;
+        md.push_str(&format!(
+            "| {i} | `{name}` | {}× | {} | {:.1}% | −{:.0}% |\n",
+            thousands(*count),
+            thousands(*rest),
+            100.0 * *rest as f64 / delivered_total as f64,
+            pct
+        ));
+    }
+    let probes: Vec<&String> = rows.iter().filter(|r| r.5).map(|r| &r.0).collect();
+    md.push_str(&format!(
+        "\n## Écartées comme sondes ({})\n\nConcentrées sur un seul jour et peu employées : \
+         c'est du trafic que j'ai fabriqué en mesurant, pas de l'usage.\n\n{}\n",
+        probes.len(),
+        probes
+            .iter()
+            .map(|p| format!("`{p}`"))
+            .collect::<Vec<_>>()
+            .join(", ")
+    ));
+    md.push_str(
+        "\n## Comment s'en servir\n\n\
+         - Le tableau dit deux choses à la fois : où une **régression** coûte le plus, et où une \
+         **amélioration** rapporte encore.\n\
+         - Un taux déjà excellent sur un énorme volume bat un taux médiocre sur un petit : gagner \
+         un point sur la première ligne rapporte plus que perfectionner la quatrième.\n\
+         - Ne pas trier sur le taux seul (sur-pondère le minuscule) ni sur le nombre d'usages seul \
+         (sur-pondère le fréquent) : c'est l'erreur que la première version de ce fichier faisait.\n",
+    );
+
+    let out = std::path::Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("../../docs/_value-ranking.md");
+    if let Err(e) = std::fs::write(&out, md) {
+        eprintln!("value_ranking: écriture impossible: {e}");
+        std::process::exit(2);
+    }
+    println!("écrit {} ({} op, {} écartées)", out.display(), rows.len(), probes.len());
+}
+
+fn thousands(n: u64) -> String {
+    let s = n.to_string();
+    let mut out = String::new();
+    for (i, c) in s.chars().enumerate() {
+        if i > 0 && (s.len() - i) % 3 == 0 {
+            out.push(' ');
+        }
+        out.push(c);
+    }
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Le tri qui a envoyé la première itération sur une cible à 0,2 %.
+    #[test]
+    fn what_is_still_delivered_is_volume_times_inefficiency() {
+        // Fréquent mais minuscule : 59 307 appels de 65 octets.
+        assert_eq!(still_delivered(3_879_492, 2_270_587), 1_608_905);
+        // Rare mais énorme : bat le précédent malgré un taux excellent.
+        assert!(still_delivered(430_000_000, 408_000_000) > still_delivered(3_879_492, 2_270_587));
+        // Un `saved` incohérent avec `before` ne doit pas déborder.
+        assert_eq!(still_delivered(10, 99), 0);
+    }
+
+    #[test]
+    fn a_one_day_burst_of_a_few_calls_is_my_own_probe() {
+        assert!(is_self_probe(1.0, 5), "5 appels le même jour : une sonde");
+        assert!(
+            !is_self_probe(1.0, 4162),
+            "4162 appels concentrés restent un usage réel — le seuil porte sur les DEUX"
+        );
+        assert!(
+            !is_self_probe(0.61, 12),
+            "peu d'appels mais étalés sur plusieurs jours : pas une sonde"
+        );
+    }
+
+    #[test]
+    fn thousands_groups_from_the_right() {
+        assert_eq!(thousands(1), "1");
+        assert_eq!(thousands(999), "999");
+        assert_eq!(thousands(1_000), "1 000");
+        assert_eq!(thousands(52_688_864), "52 688 864");
+    }
+}
diff --git a/crates/tokenade-bench/src/lib.rs b/crates/tokenade-bench/src/lib.rs
new file mode 100644
index 00000000..fc3fad7b
--- /dev/null
+++ b/crates/tokenade-bench/src/lib.rs
@@ -0,0 +1,449 @@
+//! Le banc de mesure de bout en bout — voir `docs/_loop-charter.md`, règle 2.
+//!
+//! Les autres binaires de ce crate mesurent la BIBLIOTHÈQUE, en process
+//! (`dispatch_named` & co). C'est le bon outil pour « ce compacteur replie-t-il
+//! bien ? », et c'est pour cette raison qu'aucun d'eux n'a jamais rencontré les
+//! pièges qui ont coûté **37 fautes d'instrument consignées** : ces pièges sont
+//! tous des propriétés du chemin CLI de bout en bout.
+//!
+//! Ce module est l'endroit unique où ce chemin se mesure, pour que ces pièges
+//! soient payés une fois :
+//!
+//! 1. **La sortie ne passe jamais par mon terminal.** Un `Bash` d'agent traverse
+//!    le hook, qui compacte — j'ai déjà lu ma propre sortie compactée en croyant
+//!    lire celle du produit. Ici c'est `Command::output()`, donc des octets.
+//! 2. **État neuf par banc** (`TOKENADE_CONFIG_DIR`, `TOKENADE_STASH_DIR`,
+//!    `TOKENADE_DEDUP_DB`). Sans ça le second bras d'un A/B voit un doublon que
+//!    le premier vient d'enregistrer, et rapporte « DIFFERS » à tort.
+//! 3. **La vraie extension** par document : le routage se fait par extension, et
+//!    des fichiers sondes nommés `.dat` n'atteignent aucun compacteur — un fuzz
+//!    a rendu « 0 hit » sur une version dont on SAVAIT qu'elle plantait.
+//! 4. **Le profil est déclaré**, et [`Run::ms_comparable`] refuse un temps
+//!    mesuré en debug (43× l'écart avec release, mesuré).
+//! 5. **Un signal n'est pas un succès** : [`Run::survived`] lit `code.is_some()`,
+//!    parce qu'un test dont la condition est « sortie non nulle » accepte le kill
+//!    OOM qu'il devait empêcher.
+//! 6. **Canari obligatoire** : [`conclude`] refuse de rendre « rien trouvé »
+//!    tant que la sonde n'a pas d'abord reproduit un défaut connu.
+//!
+//! Quand une sonde ment, la correction va ICI, avec un test. Jamais un
+//! contournement dans l'itération — c'est ce contournement qui a fait 37 fois.
+
+use std::path::{Path, PathBuf};
+use std::process::Command;
+use std::time::Instant;
+
+/// Quel binaire a été mesuré.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Profile {
+    Release,
+    Debug,
+}
+
+/// Ce qu'une sonde a le droit de conclure.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Verdict {
+    /// La sonde a trouvé quelque chose, et son canari avait tiré.
+    Found(Vec<String>),
+    /// Rien trouvé, ET le canari a tiré — donc l'instrument atteignait le code.
+    Clean,
+    /// Le canari n'a pas tiré : la sonde n'a rien prouvé, dans aucun sens.
+    InstrumentNotValidated(String),
+}
+
+/// Un silence ne vaut que si l'instrument a d'abord montré qu'il voyait.
+///
+/// C'est la règle qui manquait quand un fuzz de 2 568 variantes a rendu « 0 sur
+/// 1.1.9 » sur une version dont une ligne plantait à coup sûr : les fichiers
+/// sondes s'appelaient `.dat`. Sans canari, « rien trouvé » et « rien atteint »
+/// rendent le même mot.
+pub fn conclude(canary_fired: bool, findings: Vec<String>) -> Verdict {
+    if !canary_fired {
+        return Verdict::InstrumentNotValidated(
+            "le canari n'a pas reproduit le défaut connu — la sonde n'atteint pas \
+             le code qu'elle prétend mesurer, donc son silence ne dit rien"
+                .to_string(),
+        );
+    }
+    if findings.is_empty() {
+        Verdict::Clean
+    } else {
+        Verdict::Found(findings)
+    }
+}
+
+/// Le résultat d'UNE invocation du CLI.
+#[derive(Debug)]
+pub struct Run {
+    pub stdout: Vec<u8>,
+    pub stderr: Vec<u8>,
+    /// `None` = tué par un signal. Un OOM kill n'est PAS un succès.
+    pub code: Option<i32>,
+    ms: u128,
+    profile: Profile,
+}
+
+impl Run {
+    pub fn bytes(&self) -> usize {
+        self.stdout.len()
+    }
+
+    pub fn text(&self) -> String {
+        String::from_utf8_lossy(&self.stdout).into_owned()
+    }
+
+    /// Le processus s'est-il terminé de lui-même ?
+    pub fn survived(&self) -> bool {
+        self.code.is_some()
+    }
+
+    /// Le temps mesuré, **seulement s'il est comparable**.
+    ///
+    /// En debug il ne l'est pas : mesuré 2,85 s/Mo en debug contre 66 ms/Mo en
+    /// release sur le même travail, soit 43×. Un rapport avant/après reste
+    /// valide en debug ; une VALEUR ABSOLUE n'y veut rien dire.
+    pub fn ms_comparable(&self) -> Option<u128> {
+        match self.profile {
+            Profile::Release => Some(self.ms),
+            Profile::Debug => None,
+        }
+    }
+
+    /// Le temps brut, pour un RAPPORT avant/après dans le même profil.
+    pub fn ms_ratio_only(&self) -> u128 {
+        self.ms
+    }
+}
+
+/// Un banc : un binaire, un état neuf, un répertoire de fixtures.
+pub struct Bench {
+    exe: PathBuf,
+    profile: Profile,
+    state: PathBuf,
+    work: PathBuf,
+    /// `false` = le CLI lit l'état RÉEL de l'opérateur. Voir
+    /// [`Bench::reading_real_state`] : c'est une exception nommée, pas un
+    /// oubli, et elle interdit toute mesure de compaction.
+    isolated: bool,
+    exe_found: bool,
+}
+
+impl Bench {
+    /// Les seules commandes qu'un banc NON isolé a le droit de lancer : leur
+    /// réponse est l'état de l'opérateur, pas un pli à mesurer.
+    const READS_REAL_STATE: &'static [&'static str] = &["gain", "dashboard", "health"];
+
+    /// Résout le binaire (release de préférence) et s'ouvre un état neuf.
+    ///
+    /// `TOKENADE_BENCH_EXE` force un binaire précis — c'est ce qui permet de
+    /// mesurer une version PUBLIÉE à côté de l'arbre courant.
+    pub fn new() -> std::io::Result<Bench> {
+        // La résolution du binaire ne fait PAS échouer la construction : sur un
+        // clone neuf il n'y a rien dans `target/`, et un banc qui refuse de
+        // naître y ferait tomber toute la suite du workspace. L'absence surgit
+        // dans `run`, là où elle compte.
+        let (exe, profile, found) = Self::resolve_exe();
+        let root = std::env::temp_dir().join(format!(
+            "tokenade-bench-{}-{}",
+            std::process::id(),
+            std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .map(|d| d.as_nanos())
+                .unwrap_or(0)
+        ));
+        let state = root.join("state");
+        let work = root.join("work");
+        std::fs::create_dir_all(&state)?;
+        std::fs::create_dir_all(&work)?;
+        Ok(Bench {
+            exe,
+            profile,
+            state,
+            work,
+            isolated: true,
+            exe_found: found,
+        })
+    }
+
+    /// Un banc qui laisse le CLI lire l'état RÉEL de l'opérateur.
+    ///
+    /// Il n'existe que pour les commandes dont la réponse EST cet état :
+    /// `gain`, `dashboard`, `health`. Les isoler rendrait un registre vide et
+    /// un classement de valeur dérivé de rien.
+    ///
+    /// **Interdit pour une mesure de compaction** : sans magasin de dédup neuf,
+    /// le second bras d'un A/B voit le doublon que le premier vient
+    /// d'enregistrer. [`Bench::run`] le refuse.
+    pub fn reading_real_state() -> std::io::Result<Bench> {
+        let mut b = Bench::new()?;
+        b.isolated = false;
+        Ok(b)
+    }
+
+    /// Ce banc isole-t-il l'état ?
+    pub fn is_isolated(&self) -> bool {
+        self.isolated
+    }
+
+    fn resolve_exe() -> (PathBuf, Profile, bool) {
+        if let Some(p) = std::env::var_os("TOKENADE_BENCH_EXE") {
+            let p = PathBuf::from(p);
+            let profile = if p.to_string_lossy().contains("/release/") {
+                Profile::Release
+            } else {
+                Profile::Debug
+            };
+            let found = p.exists();
+            return (p, profile, found);
+        }
+        let ws = Path::new(env!("CARGO_MANIFEST_DIR"))
+            .parent()
+            .and_then(Path::parent)
+            .map(Path::to_path_buf)
+            .unwrap_or_default();
+        for (dir, profile) in [("release", Profile::Release), ("debug", Profile::Debug)] {
+            let cand = ws.join("target").join(dir).join("tokenade");
+            if cand.exists() {
+                return (cand, profile, true);
+            }
+        }
+        (ws.join("target/release/tokenade"), Profile::Release, false)
+    }
+
+    pub fn profile(&self) -> Profile {
+        self.profile
+    }
+
+    pub fn exe(&self) -> &Path {
+        &self.exe
+    }
+
+    /// Où l'état de CE banc vit. Neuf, donc la dédup n'a rien à se rappeler.
+    pub fn state_dir(&self) -> &Path {
+        &self.state
+    }
+
+    /// Écrit une fixture **avec sa vraie extension** et rend son chemin.
+    ///
+    /// L'extension n'est pas décorative : c'est par elle que le routage choisit
+    /// un compacteur. `stem` sans point, `ext` sans point.
+    pub fn fixture(&self, stem: &str, ext: &str, body: &str) -> std::io::Result<PathBuf> {
+        assert!(
+            !ext.starts_with('.'),
+            "ext sans point : `html`, pas `.html` (reçu {ext:?})"
+        );
+        assert!(
+            !ext.is_empty(),
+            "une fixture SANS extension n'atteint aucun compacteur — c'est le \
+             piège qui a fait rendre « 0 hit » à un fuzz sur une version fautive"
+        );
+        let p = self.work.join(format!("{stem}.{ext}"));
+        std::fs::write(&p, body)?;
+        Ok(p)
+    }
+
+    /// Lance le CLI et capture ses octets. La sortie ne touche jamais un
+    /// terminal, donc aucun hook ne la compacte en chemin.
+    pub fn run(&self, args: &[&str]) -> std::io::Result<Run> {
+        assert!(
+            self.isolated || Self::READS_REAL_STATE.contains(&args.first().copied().unwrap_or("")),
+            "`reading_real_state` sert aux commandes dont la réponse EST cet état \
+             ({:?}), pas à mesurer une compaction sans magasin de dédup neuf",
+            Self::READS_REAL_STATE
+        );
+        if !self.exe_found {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::NotFound,
+                format!(
+                    "aucun binaire tokenade à mesurer ({}) — `cargo build` d'abord, \
+                     ou pointer TOKENADE_BENCH_EXE",
+                    self.exe.display()
+                ),
+            ));
+        }
+        let mut c = Command::new(&self.exe);
+        c.args(args).current_dir(&self.work);
+        if self.isolated {
+            c.env("TOKENADE_CONFIG_DIR", &self.state)
+                .env("TOKENADE_STASH_DIR", self.state.join("stash"))
+                .env("TOKENADE_DEDUP_DB", self.state.join("dedup.db"));
+        }
+        // Le bypass de licence n'agit qu'en debug ; en release il est inerte et
+        // la porte de quota peut tout laisser passer. `profile()` dit lequel,
+        // pour qu'un passthrough ne soit pas lu comme une compaction.
+        c.env("TOKENADE_LICENSE_DISABLED", "1")
+            // Le hook ne doit pas se réinviter dans une mesure du hook.
+            .env_remove("TOKENADE_HOOK_ACTIVE");
+        // Le crate n'est pas balayé par les gardes de spawn de `cli`/`core`,
+        // mais un banc qui ouvre une console sur Windows reste un banc cassé.
+        tokenade_core::process_util::configure_no_window(&mut c);
+        // « Qui tue ça si le banc est SIGKILLé ? » — le garde du dépôt pose la
+        // question et il a raison : une mesure peut lancer une commande longue,
+        // et `output()` ne rend aucune poignée sur l'enfant. On l'adopte donc
+        // explicitement, comme `wrap` : le groupe n'EXISTE que si un terminal ne
+        // le possède pas déjà, et le faucheur tient la garantie pour le kill
+        // qu'on ne voit jamais passer.
+        c.stdout(std::process::Stdio::piped())
+            .stderr(std::process::Stdio::piped());
+        let t = Instant::now();
+        let child = c.spawn()?;
+        let reaper = if tokenade_core::process_util::terminal_owns_the_group() {
+            None
+        } else {
+            tokenade_core::process_util::guard_group_against_our_death(child.id())
+        };
+        let out = child.wait_with_output()?;
+        if let Some(r) = reaper {
+            r.stand_down();
+        }
+        Ok(Run {
+            stdout: out.stdout,
+            stderr: out.stderr,
+            code: out.status.code(),
+            ms: t.elapsed().as_millis(),
+            profile: self.profile,
+        })
+    }
+}
