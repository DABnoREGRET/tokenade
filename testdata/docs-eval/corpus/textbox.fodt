<?xml version="1.0" encoding="UTF-8"?>
<office:document
 xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
 xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
 xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0"
 xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"
 office:version="1.3"
 office:mimetype="application/vnd.oasis.opendocument.text">
 <office:body><office:text>
  <text:p>Body sentence NEEDLE-TB-BODY carries the argument.</text:p>
  <text:p><draw:frame draw:name="cadre1" svg:width="8cm" svg:height="2cm"
    text:anchor-type="paragraph">
    <draw:text-box><text:p>NEEDLE-TB-INSIDE the callout says this.</text:p></draw:text-box>
  </draw:frame></text:p>
  <text:p>Closing sentence NEEDLE-TB-TAIL.</text:p>
 </office:text></office:body>
</office:document>
