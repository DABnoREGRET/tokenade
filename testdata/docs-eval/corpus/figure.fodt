    <draw:image><office:binary-data>iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAACklEQVR4nGNgAAACAAEA/f8D+gAAAABJRU5ErkJggg==</office:binary-data></draw:image>
